# After every crawl, as the analyst: every log line has a known shape, and no visited path, record text or
# section 15 credential value is in a log or under the data dir. systemd hands the credential over in memory
# (%d), so the analyst never reads the crawler's file; the empty SetCredential is the default when it is absent.
# The bare id is found through /etc/credstore, a link install.sh keeps to /etc/onioncollect/testonion.env only
# while that file exists: an absolute path to a missing file fails the unit (243/CREDENTIALS) despite the default.
[Unit]
Description=onioncollect log audit

[Service]
Type=oneshot
User=analyst
Group=analyst
WorkingDirectory=/opt/onioncollect/app
LoadCredential=testonion.env
SetCredential=testonion.env:
ExecStart=/opt/onioncollect/venv/bin/python -s -E tests/live/log_audit.py --data /home/analyst/data --credentials %d /var/log/onioncollect/crawl.log /home/analyst/ui.log
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
