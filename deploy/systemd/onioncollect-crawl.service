# crawl run in the timer's mode: start what cadence says is due, stop when no page is left to fetch. It refuses
# to start without a leak test result newer than the current deploy and under 36 h old, or with any config that
# fails validation. The log audit runs as the analyst after every crawl, whatever its outcome.
[Unit]
Description=onioncollect crawl of the due live sources
After=network.target
OnSuccess=onioncollect-log-audit.service
OnFailure=onioncollect-log-audit.service

[Service]
Type=oneshot
User=crawler
Group=crawler
WorkingDirectory=/opt/onioncollect/app
ExecStart=/opt/onioncollect/venv/bin/python -s -E -m onioncollect --settings /home/crawler/settings.toml crawl run --until-idle
TimeoutStartSec=3h
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/crawler/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# Tor's SOCKS and control ports are on 127.0.0.1; nothing else is reachable from this unit.
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
