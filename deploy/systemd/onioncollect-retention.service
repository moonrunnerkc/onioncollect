# Section 3's retention clocks, as the analyst, which owns the stores.
[Unit]
Description=onioncollect retention sweep

[Service]
Type=oneshot
User=analyst
Group=analyst
WorkingDirectory=/opt/onioncollect/app
ExecStart=/opt/onioncollect/venv/bin/python -s -E -m onioncollect --settings /home/analyst/settings.toml retention sweep
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/analyst/data
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
