# Section 12's search UI, as the analyst, on 127.0.0.1:8470 only. Reach it with an SSH forward through Lima's
# ssh config. Its own entry point, never cli.py, so the process holds no network library. It reads the stores and
# never writes or fetches; the unit lets it bind its one port and nothing else.
[Unit]
Description=onioncollect search UI
After=network.target

[Service]
Type=simple
User=analyst
Group=analyst
WorkingDirectory=/opt/onioncollect/app
ExecStart=/opt/onioncollect/venv/bin/python -s -E -m onioncollect.ui_main --data-dir /home/analyst/data --configs-dir /var/lib/onioncollect/configs --port 8470
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/analyst
# The analyst owns the stores; in here they are read-only, which is what the UI's own user check asks for.
ReadOnlyPaths=/home/analyst/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindAllow=tcp:8470
SocketBindDeny=any

[Install]
WantedBy=multi-user.target
